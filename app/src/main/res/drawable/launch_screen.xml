<?xml version="1.0" encoding="utf-8"?>
<!--
    What the phone shows between the tap on the icon and the first frame of the
    app, on Android 11 and earlier. Newer versions draw their own launch screen;
    values-v31 tells them to use the same mark and the same field.

    The launcher wordmark foreground is reused here without the launcher plate. It
    stays centred on the launch field and no longer carries a square bitmap that
    Android can crop differently from the home-screen icon. No extra text or spinner: the app
    is ready in well under a second, and anything readable here would only be
    readable if something were wrong.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/window_background" />
    <item
        android:drawable="@drawable/ic_launcher_wordmark"
        android:gravity="center"
        android:width="160dp"
        android:height="160dp" />
</layer-list>
