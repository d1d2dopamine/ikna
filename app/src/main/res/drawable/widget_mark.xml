<?xml version="1.0" encoding="utf-8"?>
<!--
    The pixel wordmark on the home screen widget.

    filter="false" is the point of this file. The source is pixel art on a 38x16
    grid, and the launcher scales widget bitmaps by screen density - with
    filtering on, a 3x phone turns every hard edge into grey mush. Nearest
    neighbour keeps the pixels as pixels, which is the only reason to use a pixel
    version at this size at all.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/ikna_pixel"
    android:filter="false"
    android:gravity="left|center_vertical" />
