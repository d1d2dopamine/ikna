<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ splits "backup" into two very different things, and this app
    answers them differently.

    cloud-backup uploads to the user's Google account. The database is the
    review log: every phrase studied, every rating, every timestamp. PRIVACY.md
    keeps this out of cloud backup, so only preferences are listed here and
    allowBackup is off in the manifest. Explicit export and opt-in paired LAN
    sync are separate user-controlled history transfer routes.

    device-transfer can carry the database including its nonsecret history
    boundary. Private pairing credentials in files/device-sync are not included;
    a transferred reset database requires explicit local generation recovery.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
            Settings only: theme, font size, reminder time. Nothing studied.

            The database is missing on purpose rather than excluded by name:
            inside cloud-backup only what is listed is uploaded, and lint
            refuses an <exclude> that points outside the included paths.
        -->
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="ikna.db" />
        <!-- Database-only adopted slots, their SQLite sidecars and durable selector.
             Pairing keys remain in files/device-sync and are NOT included. -->
        <include domain="file" path="sync-profiles/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
