<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ splits "backup" into two very different things, and this app
    answers them differently.

    cloud-backup uploads to the user's Google account. The database is the
    review log: every phrase studied, every rating, every timestamp. PRIVACY.md
    says that stays on the phone, so it is excluded here and allowBackup is off
    in the manifest. The supported way to move it is the export, which the user
    triggers and places themselves.

    device-transfer is a direct copy to a new phone during setup, with no server
    in between, so the database goes with it - that is a move, not a copy to a
    stranger.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Settings only: theme, font size, reminder time. Nothing studied. -->
        <include domain="sharedpref" path="." />
        <exclude domain="database" path="ikna.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="ikna.db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
