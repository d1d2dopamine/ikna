<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon on Android 8 and later: two layers the system moves,
    masks and clips as it likes.

    The foreground is the wordmark as drawn, resampled from the 1024px original
    and never traced into paths - a wordmark redrawn as vector outlines stops
    being the same letterforms, and these letterforms are the whole logo.

    It sits inside the round-mask safe zone with room to spare, because the mask
    is a circle and a wide mark is limited by its diagonal: the first and last
    letter are what a naive fit loses.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_wordmark" />
    <monochrome android:drawable="@drawable/ic_launcher_wordmark" />
</adaptive-icon>
