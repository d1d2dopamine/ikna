<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8+ adaptive launcher icon. The patterned field and the transparent
    wordmark are separate raster layers. Keeping the wordmark inside the adaptive
    safe zone prevents launcher masks from clipping it or shifting it off-centre.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background_art" />
    <foreground android:drawable="@drawable/ic_launcher_wordmark" />
</adaptive-icon>
