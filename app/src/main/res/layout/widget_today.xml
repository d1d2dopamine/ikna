<?xml version="1.0" encoding="utf-8"?>
<!--
    The home screen widget.

    Plain views on purpose: a widget is drawn by the launcher's process, so none
    of the Compose theme, none of the custom font and none of the palette can
    reach it. What it can have is the same shape language - flat, square, one
    number - so it reads as part of the same app rather than a system tile.

    Every string in here is written by the app, already translated. The widget
    formats nothing and knows nothing about languages.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/widget_background"
    android:padding="12dp">

    <!-- The pixel wordmark, drawn at its own grid size. This is the one place in
         the product where the pixel version of the logo belongs: at 38x16 it is
         smaller than any text could be set here, and a widget needs to say which
         app it is without spending a line on it. -->
    <ImageView
        android:id="@+id/widget_mark"
        android:layout_width="38dp"
        android:layout_height="16dp"
        android:src="@drawable/widget_mark"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/app_name" />

    <TextView
        android:id="@+id/widget_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_accent"
        android:textSize="32sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:text="@string/widget_placeholder" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_ink"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

</LinearLayout>
