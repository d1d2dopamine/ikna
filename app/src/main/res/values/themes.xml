<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window background matters even though Compose paints over it: it is
         what shows during launch, behind the transparent system bars, and in the
         overscroll gap. Left at the platform default it was Theme.Material's warm
         dark grey, which is where the "brown" in the light theme came from. -->
    <style name="Theme.Ikna" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
    </style>

    <!-- The theme the launcher window wears for the fraction of a second before
         Compose draws. MainActivity hands the window back to Theme.Ikna in
         onCreate, before super, so the mark never lingers under the app. On API
         31+ the platform overrides this with values-v31. -->
    <style name="Theme.Ikna.Launch" parent="Theme.Ikna">
        <item name="android:windowBackground">@drawable/launch_screen</item>
    </style>
</resources>
