<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fallback field behind the adaptive launcher foreground. The 0.11 icon
         carries its own dark square artwork, whose outer pixels are already very
         close to the default Ink background (#0B1120). Keeping this colour tied
         to the clean-install default prevents a visible rim if a launcher exposes
         any of the adaptive-icon background around the raster foreground. -->
    <color name="ic_launcher_background">#1B2232</color>

    <!-- The default palette's dark background from Theme.kt - "Иней", matched to
         the Ikna brand banner. The app opens dark, so this is what the launch
         window should be; Compose repaints it a frame later. -->
    <color name="window_background">#1B2232</color>

    <!-- The widget wears the default Frost dark palette from Theme.kt. -->
    <color name="widget_background">#1B2232</color>
    <color name="widget_ink">#BDCAE1</color>
    <color name="widget_muted">#8C9CB8</color>
    <color name="widget_accent">#61A9AF</color>
</resources>
