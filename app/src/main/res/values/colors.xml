<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The field behind the wordmark, read straight out of the drawn icon
         artwork so the two cannot disagree. It is not window_background and not
         the old indigo: the artwork's field is #110F0F, and the adaptive icon has
         to reproduce that field after the system has applied its own mask. The
         mask is also why the artwork is not shipped whole as the foreground -
         Android rounds the corners itself, and a pre-rounded tile handed to it
         comes out clipped with a rim of wallpaper. -->
    <color name="ic_launcher_background">#110F0F</color>

    <!-- The default palette's dark background from Theme.kt — "Уголь". The app
         opens dark, so this is what the launch window should be; Compose repaints
         it a frame later. It has to be the brand colour rather than a neutral
         grey: on Android 12+ this is also the splash field, and a grey flash in
         front of a warm near-black app is visible every single launch. -->
    <color name="window_background">#17100C</color>

    <!-- The widget is drawn by the launcher, which cannot read the Compose
         palette, so the four colours it needs are duplicated here. These are the
         default palette's dark version from Theme.kt: a widget that followed the
         in-app light theme would be a white brick on most people's wallpaper.

         The widget deliberately does not follow the palette the user picked. It
         cannot — the launcher process has no access to the app's preferences at
         draw time — and a tile that lagged one palette behind the app would look
         broken rather than themed. It wears the brand instead. -->
    <color name="widget_background">#17100C</color>
    <color name="widget_ink">#F2E6D9</color>
    <color name="widget_muted">#9C8574</color>
    <color name="widget_accent">#F2683C</color>
</resources>
