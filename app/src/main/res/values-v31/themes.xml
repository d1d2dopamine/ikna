<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later draw the launch screen themselves and ignore
    windowBackground for it. On those versions the system splash is told to use
    the same centred transparent wordmark foreground used by the legacy launch screen.
    The launcher background is deliberately not baked into the splash drawable.
-->
<resources>
    <style name="Theme.Ikna.Launch" parent="Theme.Ikna">
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_wordmark</item>
    </style>
</resources>
