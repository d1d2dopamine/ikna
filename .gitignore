# The runtime for the voice build. Fetched by tools/voice/fetch-voice.sh and
# never committed: it carries native code for four architectures and is
# reproducible from the one URL in that script. The lite build needs none of it.
#
# No model is fetched or stored here any more. The model is added on the phone,
# from the file picker -- see docs/VOICE.md.
app/libs/

# Left behind by the version that packed a model into the APK.
app/src/voice/assets/kokoro/

# Downloaded and hash-checked by tools/catalog/fetch-bundled-pack.sh
app/src/main/assets/packs/en-ru-beginner.jsonl
