{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d1d2dopamine/ikna/tools/catalog/schema/catalogue-v2-candidate.schema.json",
  "title": "Catalogue v2 normalized ingestion candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidateVersion", "id", "collection", "lang", "meaningLang", "context", "meaning", "origins"],
  "properties": {
    "candidateVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^c1:"},
    "collection": {"enum": ["everyday", "knowledge", "world"]},
    "lang": {"type": "string", "minLength": 2},
    "meaningLang": {"type": "string", "minLength": 2},
    "context": {"type": "string", "minLength": 1},
    "meaning": {"type": "string", "minLength": 1},
    "origins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceFamily", "sourceVersion", "contextRef", "meaningRef"],
        "properties": {
          "sourceFamily": {"type": "string", "minLength": 1},
          "sourceVersion": {"type": "string", "minLength": 1},
          "contextRef": {"type": "string", "minLength": 1},
          "meaningRef": {"type": "string", "minLength": 1},
          "alignmentScore": {"type": "number"},
          "attribution": {"type": "object"}
        }
      }
    }
  }
}
